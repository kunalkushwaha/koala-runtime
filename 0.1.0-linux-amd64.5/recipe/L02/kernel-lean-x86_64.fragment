# R05B1: Koala's additions for the lean kernel, merged after Kata 3.17.0's
# fragments (kernel/kata-3.17.0) onto allnoconfig by build-lean-kernel.sh.
#
# Cloud Hypervisor boots the uncompressed ELF through PVH (no decompression,
# ~100 ms; L18's K1).
CONFIG_PVH=y
# PCI and CPU hotplug: Cloud Hypervisor adds devices to a running guest.
# Kata's hotplug.conf holds these and memory hotplug; only memory hotplug is
# left out (L18: without these the guest booted but never became ready).
CONFIG_HOTPLUG_CPU=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_SHPC=y
CONFIG_PCIEPORTBUS=y
# L02B (kernel-x86_64.fragment): a guest under Cloud Hypervisor sees every
# configured vCPU (x2APIC MADT entries), and AMD hosts run with their own
# CPU support.
CONFIG_CPU_SUP_AMD=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
# CPU vulnerability mitigations in the guest: the same set as the full
# profile's kernel (containerization's config). Kata's fragments ask for them
# under 6.12's name (SPECULATION_MITIGATIONS); 6.18 renamed and split them,
# and allnoconfig leaves the new ones off (R05B1: 2 of 23 without this).
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_TSA=y
CONFIG_MITIGATION_UNRET_ENTRY=y
# (MITIGATION_VMSCAPE is a KVM host's protection from its guests; it needs
# CONFIG_KVM, which a guest kernel doesn't have.)
# Hardening at least as strong as the full profile's kernel (R05B1 review).
CONFIG_FORTIFY_SOURCE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_HARDENED_USERCOPY=y
